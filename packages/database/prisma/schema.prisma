generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum DrivePhase {
  discover
  refine
  initiate
  venture
  evolve
}

enum ProjectRole {
  founder
  team
}

enum PlatformRole {
  user
  admin
  support
}

enum ProfileStatus {
  active
  deletion_pending
  deleted
}

enum ConversationKind {
  discover
  refine
  evolve
  workspace
}

enum SessionStatus {
  active
  draft
  screening
  completed
  nav_away
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum ProposalStatus {
  pending
  confirmed
  rejected
}

enum ImpactSeverity {
  red
  amber
  green
}

enum WorkStatus {
  ready
  in_progress
  review
  done
}

enum Priority {
  low
  medium
  high
  critical
}

enum ReportStatus {
  queued
  generating
  completed
  failed
}

enum BuildPhaseStatus {
  draft
  ready
  active
  closed
}

enum DeletionStatus {
  scheduled
  cancelled
  processing
  completed
}

enum FlowVersionStatus {
  draft
  published
  archived
}

enum FlowExecutionMode {
  visible_chat
  internal_helper
  deterministic
  explicit_action
  human_review
}

enum FlowRunStatus {
  active
  paused
  completed
  failed
}

enum FlowStepRunStatus {
  pending
  active
  completed
  skipped
  failed
}

enum ModelTier {
  fast
  standard
  reasoning
}

model Profile {
  id                   String                @id @db.Uuid
  email                String                @unique
  preferredName        String?
  platformRole         PlatformRole          @default(user)
  tier                 String                @default("free")
  status               ProfileStatus         @default(active)
  privacyPolicyVersion String?
  termsVersion         String?
  consentedAt          DateTime?
  deletionRequestedAt  DateTime?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  ownedProjects        Project[]             @relation("ProjectOwner")
  memberships          ProjectMembership[]
  tokenUsage           TokenUsage[]
  conversationTurns    ConversationMessage[]
  auditEvents          AuditEvent[]
  invitationsSent      Invitation[]          @relation("InvitationSender")
  invitationsAccepted  Invitation[]          @relation("InvitationAcceptor")
  consents             ConsentRecord[]
  deletionRequests     DeletionRequest[]
  dataExports          DataExport[]
  platformAuditEvents  PlatformAuditEvent[]  @relation("PlatformAuditActor")
  aiInvocations        AiInvocation[]
  streamEvents         JobStreamEvent[]
  flowVersionsCreated  FlowVersion[]         @relation("FlowVersionCreator")
  cancellations        Cancellation[]
}

model Project {
  id            String              @id @default(uuid()) @db.Uuid
  ownerId       String              @db.Uuid
  name          String
  summary       String?
  phase         DrivePhase          @default(discover)
  context       Json?
  version       Int                 @default(1)
  frozen        Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  owner         Profile             @relation("ProjectOwner", fields: [ownerId], references: [id])
  memberships   ProjectMembership[]
  invitations   Invitation[]
  goals         Goal[]
  epics         Epic[]
  stories       Story[]
  personas      Persona[]
  painPoints    PainPoint[]
  raidItems     RaidItem[]
  conversations Conversation[]
  auditEvents   AuditEvent[]
  reports       ReportGeneration[]
  documents     GeneratedDocument[]
  storageObjects StorageObject[]
  jobs          JobRecord[]
  tokenUsage    TokenUsage[]
  aiInvocations AiInvocation[]
  streamEvents  JobStreamEvent[]
  flowRuns      FlowRun[]
  evolveSessions EvolveSession[]
  buildPhases   BuildPhase[]
  healthScores  HealthScore[]
  evolveActions EvolveAction[]
  contextProposals ContextProposal[]

  @@index([ownerId])
}

model ProjectMembership {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Invitation {
  id           String      @id @default(uuid()) @db.Uuid
  projectId    String      @db.Uuid
  email        String
  role         ProjectRole
  tokenHash    String      @unique
  invitedById  String      @db.Uuid
  acceptedById String?     @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy    Profile     @relation("InvitationSender", fields: [invitedById], references: [id])
  acceptedBy   Profile?    @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([projectId, email])
}

model ConsentRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  privacyPolicyVersion String
  termsVersion         String
  ipHash               String?
  userAgent            String?
  consentedAt          DateTime @default(now())
  user                 Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeletionRequest {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  status      DeletionStatus @default(scheduled)
  executeAt   DateTime
  cancelledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  user        Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataExport {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  status          JobStatus      @default(queued)
  storageObjectId String?        @db.Uuid
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  user            Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageObject   StorageObject? @relation(fields: [storageObjectId], references: [id])
}

// --- Entity Model (V4.4: Goal → Epic → Story) ---

model Goal {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  title     String
  detail    String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epics     Epic[]

  @@index([projectId])
}

model Epic {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  goalId      String   @db.Uuid
  title       String
  description String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  stories     Story[]

  @@index([projectId])
  @@index([goalId])
}

model Story {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @db.Uuid
  epicId         String         @db.Uuid
  title          String
  description    String?
  acceptance     Json
  status         WorkStatus     @default(ready)
  priority       Priority       @default(medium)
  position       Int            @default(0)
  estimatePoints Int?
  version        Int            @default(1)
  buildPhaseId   String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic           Epic           @relation(fields: [epicId], references: [id], onDelete: Cascade)
  personas       PersonaStory[]
  buildPhase     BuildPhase?    @relation(fields: [buildPhaseId], references: [id])

  @@index([projectId, status, position])
  @@index([epicId])
  @@index([buildPhaseId])
}

model Persona {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  name        String
  description String
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  painPoints  PainPoint[]
  stories     PersonaStory[]

  @@index([projectId])
}

model PersonaStory {
  personaId String  @db.Uuid
  storyId   String  @db.Uuid
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  story     Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([personaId, storyId])
}

model PainPoint {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  personaId String   @db.Uuid
  statement String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RaidItem {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  type        String
  title       String
  description String?
  ownerId     String?   @db.Uuid
  status      String
  severity    String
  dueAt       DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model Conversation {
  id                   String                @id @default(uuid()) @db.Uuid
  projectId            String                @db.Uuid
  kind                 ConversationKind
  status               SessionStatus         @default(active)
  activeSkillId        String?
  activeSkillVersionId String?               @db.Uuid
  activeSkillPinnedAt  DateTime?
  title                String?
  retentionUntil       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activeSkill          Skill?                @relation(fields: [activeSkillId], references: [id], onDelete: SetNull)
  activeSkillVersion   SkillVersion?         @relation(fields: [activeSkillVersionId], references: [id], onDelete: SetNull)
  messages             ConversationMessage[]
  extracts             StructuredExtract[]
  flowRuns             FlowRun[]
  evolveSession        EvolveSession?

  @@index([projectId, kind])
  @@index([activeSkillId])
}

model EvolveSession {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @db.Uuid
  conversationId String        @unique @db.Uuid
  launchedFrom   String
  topic          String?
  status         SessionStatus @default(active)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions        EvolveAction[]
  contextProposals ContextProposal[]

  @@index([projectId, status])
}

// RemoraDocument §7 — Screening Engine + Action Capability.
// Goal changes get requiresScreening=true and spawn EvolveImpactItem rows
// (Impact Screener cascade); non-Goal actions (Story/RaidItem/etc.) apply
// directly on approval with no impact list. Rejections are never persisted
// past this row per doc ("rejections are not saved anywhere").
model EvolveAction {
  id                String         @id @default(uuid()) @db.Uuid
  evolveSessionId   String         @db.Uuid
  projectId         String         @db.Uuid
  entityType        String
  entityId          String?        @db.Uuid
  actionType        String
  proposedChange    Json
  requiresScreening Boolean        @default(false)
  status            ProposalStatus @default(pending)
  rationale         String?
  createdAt         DateTime       @default(now())
  decidedAt         DateTime?
  decidedByUserId   String?        @db.Uuid
  evolveSession     EvolveSession  @relation(fields: [evolveSessionId], references: [id], onDelete: Cascade)
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  impactItems       EvolveImpactItem[]

  @@index([evolveSessionId, status])
  @@index([projectId, status])
}

model EvolveImpactItem {
  id                 String         @id @default(uuid()) @db.Uuid
  evolveActionId     String         @db.Uuid
  affectedEntityType String
  affectedEntityId   String?        @db.Uuid
  severity           ImpactSeverity
  title              String
  reasoning          String
  suggestedChange    Json?
  status             ProposalStatus @default(pending)
  evolveAction       EvolveAction   @relation(fields: [evolveActionId], references: [id], onDelete: Cascade)

  @@index([evolveActionId])
}

// RemoraDocument §10 Layer 2 — AI-proposed project.context updates surfaced
// inline during Evolve conversations, confirmed or rejected by the founder.
// RemoraDocument §10 — three automation layers all feed this same table,
// distinguished by `source`. Layer 2 (Evolve inline proposals) sets
// evolveSessionId; Layer 1 (entity-pattern/roster auto-capture) and Layer 3
// (periodic drift review) run independently of any Evolve session.
enum ContextProposalSource {
  layer1
  layer2
  layer3
}

model ContextProposal {
  id              String                @id @default(uuid()) @db.Uuid
  evolveSessionId String?               @db.Uuid
  projectId       String                @db.Uuid
  proposedText    String
  source          ContextProposalSource @default(layer2)
  status          ProposalStatus        @default(pending)
  createdAt       DateTime              @default(now())
  decidedAt       DateTime?
  decidedByUserId String?               @db.Uuid
  evolveSession   EvolveSession?        @relation(fields: [evolveSessionId], references: [id], onDelete: Cascade)
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([evolveSessionId, status])
  @@index([projectId, status])
}

// Founder-defined pattern → context-text rules (RemoraDocument §20:
// "Project context auto-capture rules" must be Configuration, not code).
model ContextAutoCaptureRule {
  id             String   @id @default(uuid()) @db.Uuid
  pattern        String
  entityTypes    String[]
  contextText    String
  minOccurrences Int      @default(2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Singleton-style config row for Layer 3's scheduled drift-review Skill
// (RemoraDocument §20: "Project context review frequency" is Configuration).
model ContextReviewConfig {
  id             String   @id @default(uuid()) @db.Uuid
  cronExpression String   @default("0 3 * * 1")
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model BuildPhase {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  name             String
  description      String?
  status           BuildPhaseStatus @default(draft)
  brandKitObjectId String?          @db.Uuid
  userFlowObjectId String?          @db.Uuid
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stories          Story[]
  pack             BuildPack?
  syncUploads      BuildSyncUpload[]

  @@index([projectId])
}

model BuildPack {
  id                            String       @id @default(uuid()) @db.Uuid
  buildPhaseId                  String       @unique @db.Uuid
  status                        ReportStatus @default(queued)
  prdDocumentId                 String?      @db.Uuid
  buildSyncFileObjectId         String?      @db.Uuid
  buildSyncInstructionsObjectId String?      @db.Uuid
  projectContextSnapshot        Json?
  createdAt                     DateTime     @default(now())
  completedAt                   DateTime?
  buildPhase                    BuildPhase   @relation(fields: [buildPhaseId], references: [id], onDelete: Cascade)
}

model BuildSyncUpload {
  id                   String        @id @default(uuid()) @db.Uuid
  buildPhaseId         String        @db.Uuid
  uploadedById         String        @db.Uuid
  storageObjectId      String        @db.Uuid
  buildPhaseIdentifier String
  status               JobStatus     @default(queued)
  error                String?
  ingestedAt           DateTime?
  createdAt            DateTime      @default(now())
  buildPhase           BuildPhase    @relation(fields: [buildPhaseId], references: [id], onDelete: Cascade)
  storageObject        StorageObject @relation(fields: [storageObjectId], references: [id])

  @@index([buildPhaseId])
}

model HealthScore {
  id                  String                 @id @default(uuid()) @db.Uuid
  projectId           String                 @db.Uuid
  overallScore        Int
  readinessAssessment String
  calculatedAt        DateTime               @default(now())
  skillVersionId      String                 @db.Uuid
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillVersion        SkillVersion           @relation(fields: [skillVersionId], references: [id])
  components          HealthScoreComponent[]

  @@index([projectId, calculatedAt])
}

model HealthScoreComponent {
  id            String      @id @default(uuid()) @db.Uuid
  healthScoreId String      @db.Uuid
  component     String
  weight        Int
  score         Int
  rationale     String
  actions       Json
  healthScore   HealthScore @relation(fields: [healthScoreId], references: [id], onDelete: Cascade)

  @@index([healthScoreId])
}

model ConversationMessage {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @db.Uuid
  actorId         String?      @db.Uuid
  role            String
  content         String
  skillId         String?
  skillVersionId  String?      @db.Uuid
  createdAt       DateTime     @default(now())
  documentName    String?
  documentContent String?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor           Profile?     @relation(fields: [actorId], references: [id])
  skill           Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([skillId])
}

model StructuredExtract {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  schemaVersion  Int
  payload        Json
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id          String                      @id
  name        String
  description String
  active      Boolean                     @default(true)
  embedding   Unsupported("vector(1024)")?
  versions    KnowledgeBaseVersion[]
  mappings    KnowledgeBaseTopicMapping[]
}

model KnowledgeBaseVersion {
  id              String        @id @default(uuid()) @db.Uuid
  knowledgeBaseId String
  version         Int
  markdown        String
  active          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, version])
}

model KnowledgeBaseTopicMapping {
  id              String        @id @default(uuid()) @db.Uuid
  knowledgeBaseId String
  topic           String
  priority        Int           @default(0)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, topic])
}

model Skill {
  id                   String                @id
  name                 String
  description          String
  phase                DrivePhase            @default(discover)
  kbEligible           Boolean               @default(false)
  versions             SkillVersion[]
  mappings             SkillEventMapping[]
  flowSteps            FlowStep[]
  conversations        Conversation[]
  conversationMessages ConversationMessage[]
}

model SkillVersion {
  id                  String         @id @default(uuid()) @db.Uuid
  skillId             String
  version             Int
  active              Boolean        @default(false)
  systemPrompt        String
  modelTier           ModelTier      @default(standard)
  inputSourceMap      Json           @default("{}")
  outputSchema        Json?
  constraints         Json
  examples            Json
  retryPolicy         Json
  createdAt           DateTime       @default(now())
  skill               Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tokenUsage          TokenUsage[]
  aiInvocations       AiInvocation[]
  flowStepRuns        FlowStepRun[]
  pinnedConversations Conversation[]
  healthScores        HealthScore[]

  @@unique([skillId, version])
}

model SkillEventMapping {
  id          String  @id @default(uuid()) @db.Uuid
  eventType   String
  conditions  Json    @default("{}")
  skillId     String
  targetQueue String
  active      Boolean @default(true)
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([eventType, skillId])
}

model FlowDefinition {
  id          String        @id
  name        String
  description String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    FlowVersion[]
}

model FlowVersion {
  id               String            @id @default(uuid()) @db.Uuid
  flowDefinitionId String
  version          Int
  status           FlowVersionStatus @default(draft)
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  publishedAt      DateTime?
  definition       FlowDefinition    @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)
  createdBy        Profile?          @relation("FlowVersionCreator", fields: [createdById], references: [id])
  steps            FlowStep[]
  runs             FlowRun[]

  @@unique([flowDefinitionId, version])
  @@index([flowDefinitionId, status])
}

model FlowStep {
  id                   String            @id @default(uuid()) @db.Uuid
  flowVersionId        String            @db.Uuid
  key                  String
  displayName          String
  description          String?
  skillId              String?
  parentStepKey        String?
  position             Int
  executionMode        FlowExecutionMode
  optional             Boolean           @default(false)
  requiresConfirmation Boolean           @default(false)
  entryRules           Json
  requiredOutputs      Json
  completionRules      Json
  transitionRules      Json
  flowVersion          FlowVersion       @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  skill                Skill?            @relation(fields: [skillId], references: [id])
  runs                 FlowStepRun[]

  @@unique([flowVersionId, key])
  @@unique([flowVersionId, position])
  @@index([flowVersionId, parentStepKey])
}

model FlowRun {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  conversationId String           @db.Uuid
  flowVersionId  String           @db.Uuid
  currentStepKey String?
  status         FlowRunStatus    @default(active)
  context        Json
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  completedAt    DateTime?
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flowVersion    FlowVersion      @relation(fields: [flowVersionId], references: [id])
  stepRuns       FlowStepRun[]
  questions      QuestionLedger[]

  @@index([projectId, status])
  @@index([flowVersionId])
}

model FlowStepRun {
  id              String            @id @default(uuid()) @db.Uuid
  flowRunId       String            @db.Uuid
  flowStepId      String            @db.Uuid
  skillVersionId  String?           @db.Uuid
  status          FlowStepRunStatus @default(pending)
  inputSnapshot   Json
  producedOutputs Json
  missingOutputs  Json
  startedAt       DateTime?
  completedAt     DateTime?
  flowRun         FlowRun           @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  flowStep        FlowStep          @relation(fields: [flowStepId], references: [id])
  skillVersion    SkillVersion?     @relation(fields: [skillVersionId], references: [id])
  questions       QuestionLedger[]

  @@unique([flowRunId, flowStepId])
  @@index([flowRunId, status])
}

model QuestionLedger {
  id         String       @id @default(uuid()) @db.Uuid
  flowRunId  String       @db.Uuid
  stepRunId  String?      @db.Uuid
  fieldKey   String
  question   String
  answer     String?
  status     String       @default("asked")
  askedAt    DateTime     @default(now())
  answeredAt DateTime?
  flowRun    FlowRun      @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  stepRun    FlowStepRun? @relation(fields: [stepRunId], references: [id], onDelete: SetNull)

  @@index([flowRunId, status])
}

model ReportDefinition {
  id          String                    @id
  name        String
  description String
  active      Boolean                   @default(true)
  versions    ReportDefinitionVersion[]
  generations ReportGeneration[]
}

model ReportDefinitionVersion {
  id                  String           @id @default(uuid()) @db.Uuid
  reportDefinitionId  String
  version             Int
  active              Boolean          @default(false)
  contextRequirements Json
  permittedRoles      Json
  outputSchema        Json
  templateKey         String
  requiresLlm         Boolean          @default(true)
  createdAt           DateTime         @default(now())
  definition          ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)

  @@unique([reportDefinitionId, version])
}

model ReportGeneration {
  id                 String                @id @default(uuid()) @db.Uuid
  projectId          String                @db.Uuid
  reportDefinitionId String
  requestedById      String                @db.Uuid
  status             ReportStatus          @default(queued)
  error              String?
  createdAt          DateTime              @default(now())
  completedAt        DateTime?
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition         ReportDefinition      @relation(fields: [reportDefinitionId], references: [id])
  sourceSnapshot     ReportSourceSnapshot?
  content            ReportContent?
  document           GeneratedDocument?

  @@index([projectId, createdAt])
}

model ReportSourceSnapshot {
  id                 String           @id @default(uuid()) @db.Uuid
  reportGenerationId String           @unique @db.Uuid
  payload            Json
  createdAt          DateTime         @default(now())
  generation         ReportGeneration @relation(fields: [reportGenerationId], references: [id], onDelete: Cascade)
}

model ReportContent {
  id                 String           @id @default(uuid()) @db.Uuid
  reportGenerationId String           @unique @db.Uuid
  structuredContent  Json
  createdAt          DateTime         @default(now())
  generation         ReportGeneration @relation(fields: [reportGenerationId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id          String                    @id
  name        String
  description String
  type        String                    @default("report") // "founder-pack" | "product-pack" | "build-pack" | "report"
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @default(now()) @updatedAt
  versions    DocumentTemplateVersion[]
}

model DocumentTemplateVersion {
  id                 String              @id @default(uuid()) @db.Uuid
  documentTemplateId String
  version            Int
  active             Boolean             @default(false)
  html               String
  css                String
  schema             Json?
  createdBy          String?             @db.Uuid
  createdAt          DateTime            @default(now())
  template           DocumentTemplate    @relation(fields: [documentTemplateId], references: [id], onDelete: Cascade)
  documents          GeneratedDocument[]

  @@unique([documentTemplateId, version])
}

model GeneratedDocument {
  id                 String                   @id @default(uuid()) @db.Uuid
  projectId          String                   @db.Uuid
  reportGenerationId String?                  @unique @db.Uuid
  type               String
  status             JobStatus                @default(queued)
  templateVersion    Int
  templateVersionId  String?                  @db.Uuid
  storageObjectId    String?                  @db.Uuid
  expiresAt          DateTime?
  createdAt          DateTime                 @default(now())
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportGeneration   ReportGeneration?        @relation(fields: [reportGenerationId], references: [id])
  storageObject      StorageObject?           @relation(fields: [storageObjectId], references: [id])
  templateVer        DocumentTemplateVersion? @relation(fields: [templateVersionId], references: [id])
}

model CostConfig {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  name            String
  unit            String
  currency        String   @default("USD")
  active          Boolean  @default(true)
  inputCostMinor  Int      @default(0)
  outputCostMinor Int      @default(0)
  flatCostMinor   Int      @default(0)
  version         Int      @default(1)
  updatedBy       String?  @db.Uuid
  updatedAt       DateTime @updatedAt
}

model HealthScoreWeightConfig {
  id        String   @id @default(uuid()) @db.Uuid
  component String   @unique
  weight    Int
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
}

model StorageObject {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String?             @db.Uuid
  bucket      String
  path        String              @unique
  mimeType    String
  sizeBytes   Int
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents   GeneratedDocument[]
  dataExports DataExport[]
  buildSyncUploads BuildSyncUpload[]
}

model JobRecord {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String?          @db.Uuid
  userId      String?          @db.Uuid
  bossJobId   String?          @unique
  queue       String
  status      JobStatus        @default(queued)
  payload     Json
  result      Json?
  attempts    Int              @default(0)
  error       String?
  runAfter    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attemptsLog JobAttempt[]
  outboxEvent OutboxEvent?
  streamEvents JobStreamEvent[]

  @@index([status, runAfter])
}

model OutboxEvent {
  id           String    @id @default(uuid()) @db.Uuid
  jobRecordId  String    @unique @db.Uuid
  topic        String
  payload      Json
  attempts     Int       @default(0)
  dispatchedAt DateTime?
  createdAt    DateTime  @default(now())
  job          JobRecord @relation(fields: [jobRecordId], references: [id], onDelete: Cascade)

  @@index([dispatchedAt, createdAt])
}

model JobAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  jobRecordId String    @db.Uuid
  attempt     Int
  status      JobStatus
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  job         JobRecord @relation(fields: [jobRecordId], references: [id], onDelete: Cascade)

  @@unique([jobRecordId, attempt])
}

model IdempotencyRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  key       String
  operation String
  response  Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, key, operation])
}

model AiInvocation {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  projectId      String       @db.Uuid
  skillVersionId String       @db.Uuid
  requestId      String       @unique
  model          String
  status         String
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  costMinor      Int          @default(0)
  latencyMs      Int?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  user           Profile      @relation(fields: [userId], references: [id])
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillVersion   SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  failures       AiFailure[]
}

model AiFailure {
  id             String       @id @default(uuid()) @db.Uuid
  aiInvocationId String       @db.Uuid
  code           String
  message        String
  retryable      Boolean
  createdAt      DateTime     @default(now())
  invocation     AiInvocation @relation(fields: [aiInvocationId], references: [id], onDelete: Cascade)
}

model TokenUsage {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  projectId      String        @db.Uuid
  skillVersionId String?       @db.Uuid
  requestId      String        @unique
  model          String
  inputTokens    Int
  outputTokens   Int
  costMinor      Int
  createdAt      DateTime      @default(now())
  user           Profile       @relation(fields: [userId], references: [id])
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillVersion   SkillVersion? @relation(fields: [skillVersionId], references: [id])
}

enum AuditEventSource {
  evolve_session
  build_sync
  manual_edit
  auto_detection
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  actorId    String   @db.Uuid
  eventType  String
  entityType String?
  entityId   String?  @db.Uuid
  before     Json?
  after      Json?
  source     AuditEventSource?
  metadata   Json
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      Profile  @relation(fields: [actorId], references: [id])

  @@index([projectId, createdAt])
}

model PlatformAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  eventType  String
  targetType String?
  targetId   String?
  metadata   Json
  createdAt  DateTime @default(now())
  actor      Profile  @relation("PlatformAuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
}

model RetentionPolicy {
  id            String   @id
  description   String
  retentionDays Int?
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model RetentionRun {
  id          String             @id @default(uuid()) @db.Uuid
  status      JobStatus          @default(running)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  items       RetentionRunItem[]
}

model RetentionRunItem {
  id             String       @id @default(uuid()) @db.Uuid
  retentionRunId String       @db.Uuid
  policyId       String
  affectedCount  Int          @default(0)
  error          String?
  run            RetentionRun @relation(fields: [retentionRunId], references: [id], onDelete: Cascade)
}

model JobStreamEvent {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @db.Uuid
  projectId String?   @db.Uuid
  userId    String?   @db.Uuid
  sequence  Int
  type      String
  delta     String?
  snapshot  String?
  metadata  Json?
  createdAt DateTime  @default(now())
  job       JobRecord @relation(fields: [jobId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      Profile?  @relation(fields: [userId], references: [id])

  @@unique([jobId, sequence])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([jobId, sequence])
}

model Cancellation {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  cancelledAt        DateTime @default(now())
  reason             String
  subscriberDuration Int
  tierAtCancellation String
  user               Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
