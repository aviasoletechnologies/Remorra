{
  "name": "@remorra/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && node --env-file=.env --import tsx dist/main.js",
    "start": "node --env-file=.env --import tsx dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "acceptance": "node --env-file=.env --import tsx scripts/production-acceptance.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.1",
    "@nestjs/common": "11.1.26",
    "@nestjs/core": "11.1.26",
    "@nestjs/platform-express": "11.1.26",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@remorra/contracts": "workspace:*",
    "@remorra/database": "workspace:*",
    "@supabase/supabase-js": "2.108.1",
    "@xenova/transformers": "^2.17.2",
    "ajv": "8.17.1",
    "file-type": "^22.0.1",
    "helmet": "8.1.0",
    "jose": "6.1.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg-boss": "12.14.0",
    "puppeteer": "25.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/multer": "^2.1.0",
    "@types/pg": "8.16.0",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "vitest": "4.1.8"
  }
}
