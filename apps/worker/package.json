{
  "name": "@remorra/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && node --env-file=.env --import tsx dist/main.js",
    "start": "node --env-file=.env --import tsx dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests"
