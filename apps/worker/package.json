    "ajv": "8.17.1",
    "pg-boss": "12.14.0",
    "puppeteer": "25.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.22.4",
    "vitest": "4.1.8"
  }
}
